{
  "name": "@shh-vc/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "build:direct": "VITE_TRANSPORT=direct vite build --base ./ --outDir dist-pages",
    "build:direct-test": "VITE_TRANSPORT=direct VITE_RELAYS=ws://127.0.0.1:7447 vite build --outDir dist-direct-test",
    "test:e2e:direct": "npm run build:direct-test && E2E_MODE=direct vitest run --config vitest.e2e.config.ts",
    "build:file": "VITE_TRANSPORT=direct VITE_SINGLEFILE=1 vite build --base ./ --outDir dist-file",
    "build:file-test": "VITE_TRANSPORT=direct VITE_SINGLEFILE=1 VITE_RELAYS=ws://127.0.0.1:7447 vite build --base ./ --outDir dist-file-test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@noble/curves": "^1.8.1",
    "@noble/hashes": "^1.7.1",
    "@preact/signals": "^2.11.4",
    "@sapphi-red/web-noise-suppressor": "^0.4.1",
    "deepfilternet3-noise-filter": "^1.3.0",
    "livekit-client": "^2.24.1",
    "lucide-preact": "^1.74.0",
    "preact": "^11.2.0",
    "trystero": "^0.27.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^3.0.5"
  }
}
